{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Setting"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "My Blog",
      "required": true
    },
    "tagline": {
      "type": "string"
    },
    "postsPerPage": {
      "type": "integer",
      "default": 10,
      "min": 1,
      "max": 100
    },
    "footerText": {
      "type": "text"
    },
    "socialLink": {
      "type": "component",
      "component": "shared.social-link",
      "repeatable": true
    }
  }
}
